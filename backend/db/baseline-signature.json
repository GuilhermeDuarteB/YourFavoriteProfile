  "views": [
    {
      "name": "vw_media_rating",
      "definition": " SELECT m.id AS media_id,\n    m.title,\n    avg(r.score) AS avg_score\n   FROM media m\n     JOIN reviews r ON r.media_id = m.id\n  WHERE m.type::text = ANY (ARRAY['movie'::character varying, 'game'::character varying]::text[])\n  GROUP BY m.id, m.title;"
    },
    {
      "name": "vw_series_rating",
      "definition": " SELECT m.id AS media_id,\n    m.title,\n    avg(ep_avg.avg_score) AS series_score\n   FROM media m\n     JOIN seasons se ON se.media_id = m.id\n     JOIN episodes ep ON ep.season_id = se.id\n     JOIN ( SELECT reviews.episode_id,\n            avg(reviews.score) AS avg_score\n           FROM reviews\n          WHERE reviews.episode_id IS NOT NULL\n          GROUP BY reviews.episode_id) ep_avg ON ep_avg.episode_id = ep.id\n  WHERE m.type::text = 'series'::text\n  GROUP BY m.id, m.title;"
    }
